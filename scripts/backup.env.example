# Copy to backup.env (gitignored) on the server and fill in a real password.
# Never commit backup.env — it holds the restic repository password. Losing
# this password means the backups on /DATA/Backup are unrecoverable, since
# restic encrypts everything with it; store a copy somewhere off this box
# (password manager), not just in this file.

# Path *inside the restic container* — /DATA/Backup is bind-mounted to
# /backup, so this resolves to /DATA/Backup/repo on the host.
RESTIC_REPOSITORY=/backup/repo

RESTIC_PASSWORD=changeme

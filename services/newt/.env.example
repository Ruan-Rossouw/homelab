# Copy to .env and fill in with real values once the Pangolin VPS exists
# and a Site has been created for homelab-server in its dashboard. See
# ../pangolin/README.md's "Manual Setup (VPS Side)" runbook, step 4.

# The Pangolin control plane's public URL, e.g. https://your-domain.example
PANGOLIN_ENDPOINT=

# Generated by Pangolin when the "homelab-server" Site is created.
NEWT_ID=

# Generated alongside NEWT_ID. Treat like any other credential -- this
# goes into secrets.enc.env (sops+age), never committed in plaintext. See
# docs/secrets.md.
NEWT_SECRET=

# Copy to .env and adjust if needed.

# Host port for the Grafana web UI. Defaults to 3002, not Grafana's own
# default of 3000 - AdGuard Home's admin UI already uses 3000, and
# Uptime Kuma already uses 3001. See README.md for the full port map.
GRAFANA_PORT=3002

# ntfy topic for the alerting contact point (config/provisioning/alerting/).
# Deliberately not committed -- a public ntfy.sh topic name is effectively
# a shared secret (anyone who knows/guesses it can read or publish to it),
# and this repo is public. Same topic already used by Uptime Kuma/Backrest.
NTFY_TOPIC=your-ntfy-topic-here

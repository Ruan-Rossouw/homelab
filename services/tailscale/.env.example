# Copy to .env. Not required for the recommended first-run flow (see README) --
# leave TS_AUTHKEY blank to authenticate interactively via a browser link the
# first time the container starts.

# Optional: a pre-generated auth key from the Tailscale admin console
# (Settings > Keys), useful for unattended re-deploys. Leave blank otherwise.
TS_AUTHKEY=

# Home LAN subnet advertised to the tailnet, so tailnet devices can reach
# any host on it (not just this server) by its LAN IP -- e.g. AdGuard DNS
# rewrites like portainer.home resolve to a LAN IP, which only works
# remotely if that subnet is routed. Requires host-level IP forwarding and
# approval in the Tailscale admin console -- see README. Set blank to stop
# advertising it (existing approved route in the admin console would need
# manual removal too).
TS_ROUTES=192.168.68.0/24

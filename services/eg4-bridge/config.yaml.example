# Copy to /DATA/AppData/eg4-bridge/config.yaml on the server and fill in the
# real MQTT password (see README's "First Run"). Not copied into the repo
# as a real config — it holds the MQTT credential, so it lives only in the
# persistent AppData volume, same reasoning as Mosquitto's passwd file
# (services/mosquitto/README.md's "Auth").

loglevel: info
strict_data_check: false
homeassistant_enabled: true   # the whole reason this service exists
read_only: true                # monitoring only — no register writes, see README
register_read_interval: 60
register_file: /app/doc/eg4_registers.json

inverters:
  - enabled: true
    host: 192.168.68.103       # dongle's DHCP-reserved LAN IP, see docs/networking.md
    port: 8000
    serial: "1383022629"       # inverter serial, from LuxCloud
    datalog: "BA11340095"      # dongle/datalogger serial, from LuxCloud
    heartbeats: false
    publish_holdings_on_connect: false
    use_tcp_nodelay: true
    read_timeout: 900
    register_block_size: 40
    read_only: true

databases: []

mqtt:
  enabled: true
  host: 192.168.68.110         # the server's own LAN IP — Mosquitto is a
                                # separate compose project, so container DNS
                                # names don't resolve across it; same
                                # cross-service pattern as every other
                                # service in this repo (Uptime Kuma monitors,
                                # etc.), not container networking
  port: 1883
  username: homeassistant
  password: changeme           # match Mosquitto's mosquitto_passwd value
  namespace: eg4                # topic prefix for readings; discovery config
                                # itself always goes under homeassistant/
                                # (mqtt.homeassistant.prefix, left at its
                                # default — matches HA's own default
                                # discovery prefix, no reason to diverge)

influx:
  enabled: false

scheduler:
  enabled: false

verbose: false
human_timestamps: false
show_unknown: false

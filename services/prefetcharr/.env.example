# Copy to .env and adjust if needed.

# Timezone Prefetcharr uses for log timestamps, matching the rest of the stack.
TZ=Africa/Johannesburg

# Jellyfin base URL and API key (Administration -> Dashboard -> Advanced -> API Keys).
JELLYFIN_URL=http://192.168.68.110:8096
JELLYFIN_API_KEY=

# Sonarr base URL and API key (Settings -> General -> Security).
SONARR_URL=http://192.168.68.110:8989
SONARR_API_KEY=

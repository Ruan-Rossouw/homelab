# Copy to .env and adjust if needed.

# Host port for the Backrest web UI.
BACKREST_PORT=9898

# Timezone Backrest uses for its own schedule display/logging.
# Corrected 2026-07-29 -- previously defaulted to Europe/London, inferred
# from "BST" timestamps seen in this server's systemd/restic output at
# the time. That inference was wrong for a server physically in South
# Africa; worth checking the host's own clock (`timedatectl status`) is
# actually set to Africa/Johannesburg too, not just this container.
TZ=Africa/Johannesburg

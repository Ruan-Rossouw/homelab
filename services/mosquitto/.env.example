# Copy to .env and adjust if needed.

# Host port for the MQTT listener.
MOSQUITTO_PORT=1883

# Not consumed by this compose.yml directly (Mosquitto reads credentials from
# the generated passwd file, not the environment) — documented here so
# lxp-bridge's and Home Assistant's own .env files can reference the same
# values. See README's "First Run" for generating the actual passwd file.
MQTT_USERNAME=homeassistant
MQTT_PASSWORD=changeme

# Copy to .env and adjust if needed. No secrets here -- Filebrowser's
# own admin/friend credentials are set through its web UI on first run,
# not via environment variables (see README's "First-Run Setup").

# Host port Filebrowser listens on. Not meant to be reached directly from
# the LAN or internet -- only via the Pangolin Resource pointed at this
# port (services/pangolin/README.md). No AdGuard .home rewrite or Caddy
# block needed for this one, unlike most services in this repo.
FILEBROWSER_PORT=8091

TZ=Africa/Johannesburg
